<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="ferme.ui.navigation.NavigationController"
    xmlns:fx="http://javafx.com/fxml">
    <left>
        <VBox spacing="0" styleClass="sidebar">
            <!-- Header -->
            <VBox spacing="0" styleClass="sidebar-header">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="◈" styleClass="sidebar-logo" />
                    <VBox spacing="0" alignment="CENTER_LEFT">
                        <Label text="Smart Farm" styleClass="sidebar-title" />
                        <Label text="Management" styleClass="sidebar-subtitle" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Navigation -->
            <VBox spacing="0" styleClass="sidebar-nav" VBox.vgrow="ALWAYS">
                <Label text="Farm" styleClass="sidebar-section" />
                <Button fx:id="navDashboard" text="Dashboard" styleClass="nav-button" />
                <Button fx:id="navAlerts" text="Alerts" styleClass="nav-button" />
                <Button fx:id="navZones" text="Zones" styleClass="nav-button" />
                <Button fx:id="navAquaculture" text="Aquaculture" styleClass="nav-button" />
                <Button fx:id="navCultures" text="Cultures" styleClass="nav-button" />
                <Button fx:id="navAnimals" text="Animals" styleClass="nav-button" />

                <Label text="Data" styleClass="sidebar-section" />
                <Button fx:id="navSensors" text="Sensors" styleClass="nav-button" />
                <Button fx:id="navReadings" text="Readings &amp; Production" styleClass="nav-button" />
                <Button fx:id="navImports" text="Imports" styleClass="nav-button" />

                <Label text="System" styleClass="sidebar-section" />
                <Button fx:id="navSettings" text="Settings" styleClass="nav-button" />
            </VBox>

            <!-- Footer -->
            <Label text="v2.0" styleClass="sidebar-footer" />
        </VBox>
    </left>
    <top>
        <HBox spacing="14" styleClass="top-bar" alignment="CENTER_LEFT">
            <Label text="Smart Farm Manager" styleClass="top-title" />
            <Label text="·" styleClass="top-separator" />
            <Label fx:id="farmNameLabel" text="No farm loaded" styleClass="farm-name" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="alertBadgeLabel" text="0" styleClass="badge badge-pulse" visible="false" managed="false">
                <HBox.margin>
                    <Insets right="4" />
                </HBox.margin>
            </Label>
            <Button fx:id="importButton" text="Import Data" styleClass="secondary-button" />
            <Button fx:id="newFarmButton" text="+ New Farm" styleClass="primary-button" />
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentPane" styleClass="content-area" />
    </center>
</BorderPane>
