<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox VBox.vgrow="ALWAYS" fx:controller="ferme.ui.controllers.AquacultureController"
    xmlns:fx="http://javafx.com/fxml" spacing="20" styleClass="page">
    <VBox spacing="4">
        <Label text="Aquaculture" styleClass="page-title" />
        <Label text="Manage aquaculture zones, feeding programs, and harvest weights" styleClass="farm-name" />
    </VBox>
    <HBox spacing="10" styleClass="toolbar">
        <Button fx:id="addSpeciesButton" text="+ Add Species" styleClass="primary-button" />
        <Button fx:id="editFeedingProgramButton" text="Edit Feeding Program" />
        <Button fx:id="recordHarvestButton" text="Record Harvest Weight" />
    </HBox>
    <TableView VBox.vgrow="ALWAYS" fx:id="aquacultureTable" />
    <VBox fx:id="speciesDetailBox" spacing="8" styleClass="card" managed="false" visible="false">
        <Label text="Species Details" styleClass="section-title" />
        <TableView VBox.vgrow="ALWAYS" fx:id="speciesTable" prefHeight="150" />
    </VBox>
</VBox>
